# =============================================================================
# Secure Networking Tracker — environment template
# =============================================================================
# Copy to .env.local and fill in the values from your own Neon project.
# .env.local is gitignored. Never commit real values.
#
# Both variables below are PUBLIC by design: they are HTTPS endpoints that ship
# to the browser, which is why the contacts table is protected by Row Level
# Security rather than by keeping these URLs secret.
# -----------------------------------------------------------------------------

# Neon Managed Better Auth endpoint.
# Neon Console -> your project -> Branch -> Auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-12345678.us-east-1.aws.neon.tech/neondb/auth

# Neon Data API (PostgREST) endpoint.
# Neon Console -> your project -> Database -> Data API
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-12345678.us-east-1.aws.neon.tech/neondb/rest/v1


# -----------------------------------------------------------------------------
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_ and never commit them.
# This app does not need them at runtime — the browser reaches Postgres through
# the Data API, not through a connection string. They are listed because the
# optional two-account RLS integration test uses them.
# -----------------------------------------------------------------------------

# Postgres connection string. Server-side / local tooling only.
# DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Only needed if you add server-side Better Auth routes (this build does not).
# NEON_AUTH_BASE_URL=https://ep-example-12345678.us-east-1.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32


# -----------------------------------------------------------------------------
# Optional: credentials for the two-account RLS privacy test.
# Create these two accounts through the app's own sign-up page, then run:
#   npm run test:rls
# Without them, that suite is skipped and the unit tests still run.
# -----------------------------------------------------------------------------
# TEST_USER_A_EMAIL=user-a@example.com
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=user-b@example.com
# TEST_USER_B_PASSWORD=
